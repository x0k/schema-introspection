{
  "name": "@schema-introspection/valibot",
  "version": "0.0.0",
  "description": "A schema introspection adapter for Valibot",
  "keywords": [
    "adapter",
    "introspection",
    "schema",
    "valibot"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc -p test/tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@schema-introspection/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "valibot": "^1.0.0"
  }
}
