{
  "name": "@schema-introspection/json-schema-draft-07",
  "version": "0.1.0",
  "description": "A schema introspection adapter for JSON Schema draft-07",
  "keywords": [
    "adapter",
    "introspection",
    "json-schema",
    "schema"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc -p test/tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@schema-introspection/spec": "workspace:*",
    "@types/json-schema": "^7.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@x0k/json-schema-merge": "^1.1.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  }
}
