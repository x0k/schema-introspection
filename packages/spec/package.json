{
  "name": "@schema-introspection/spec",
  "version": "0.1.0",
  "description": "A type-only protocol for schema introspection",
  "keywords": [
    "interface",
    "introspection",
    "schema",
    "standard",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x0k/schema-introspection.git",
    "directory": "packages/spec"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "schema-introspection-spec": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
